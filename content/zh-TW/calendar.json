            "scenes": [
              {
                "locationId": "dormitories",
                "castIds": [],
                "lines": [
                  "*霧月假期即將到來。四天沒課，半個校園都在討論要去哪裡。*",
                  "*我一直想去索特米爾的溫泉。蒸汽、楓林、湖泊，還有一個無須奔波的地方。*",
                  "*若有人作伴會更好。我該帶誰去呢？*"
                ]
              }
            ]
          },
          "booking": {
            "eventId": "mistmoon-break",
            "most": 2,
            "price": 150,
            "minStage": "dating",
            "blurb": "位於林木丘陵間的溫泉小鎮，距離大學僅需數小時車程：古老的木造旅館、冒著熱氣的石池、位於城鎮上方的瀑布與下方的湖泊，還有王國裡最美的秋色。",
            "highlights": [
              "星空下的露天溫泉",
              "專屬您的私人雪松浴池",
              "通往瀑布的楓林小徑",
              "燈籠點亮的夜市",
              "最後一晚湖面上的煙火",
              "在專屬陽臺迎接日出早餐",
              "與心愛之人共度四天假期"
            ],
            "rating": 4.9
          }
        }
      ]
    },
